<launch>
  <!-- 无人机名称参数 -->
    <arg name="mav_name" default="hummingbird"/>
    <include file="$(find rotors_gazebo)/launch/mav_hovering_example_with_vi_sensor.launch">
      <arg name="mav_name" value="$(arg mav_name)"/> 
  </include>
  



  <!-- 启动 zbar_ros 节点 -->
  <node name="zbar_ros" pkg="zbar_ros" type="barcode_reader_node" output="screen">
    <!-- 订阅 Gazebo 摄像头话题 -->
    <remap from="image"       to="/$(arg mav_name)/vi_sensor/camera_depth/camera/image_raw"/>
    <remap from="camera_info" to="/$(arg mav_name)/vi_sensor/camera_depth/camera/camera_info"/>
    
    <!-- 关键参数配置 -->
    <param name="symbols"      value="QR-CODE"/>
    <param name="show_image"   value="false"/>
    <param name="throttle_rate" value="30.0"/> <!-- 限制处理频率 -->
    <param name="resolution"    value="0.7"/> 
  </node>

  <node pkg="aruco_ros" type="single" name="aruco_detector">
    <!-- 订阅RGB相机话题 -->
    <remap from="/camera_info" 
           to="/$(arg mav_name)/vi_bottom_sensor/camera_2/camera_info"/>
    <remap from="/image" 
           to="/$(arg mav_name)/vi_bottom_sensor/camera_2/image_raw"/>
    <remap from="/aruco_single/pose" to="/aruco_detector/pose"/>
    <remap from="/aruco_single/result" to="/aruco_detector/result"/>
    <!-- ArUco关键参数配置 -->
    <param name="image_is_rectified" value="true"/>
    <param name="marker_size" value="0.08"/>
    <param name="dictionary" value="10"/> 
    <param name="marker_id"         value="162"/>   <!-- 要检测的标记ID -->
    <param name="reference_frame"   value="$(arg mav_name)/base_link"/> <!-- 坐标系基准 -->
    <param name="camera_frame"      value="$(arg mav_name)/vi_bottom_sensor_optical_frame"/>
  </node>

  <!-- 相机坐标系变换（根据实际安装位置调整） -->
  <node pkg="tf" type="static_transform_publisher" name="camera_tf"
        args="0.019 0.0 -0.045 3.14159 1.5708 0.0 
        $(arg mav_name)/base_link 
        $(arg mav_name)/vi_bottom_sensor_optical_frame 100">
        <param name="child_frame_id" value="$(arg mav_name)/vi_bottom_sensor_optical_frame"/>
  </node>

  <!-- 可选：图像显示 -->
  <node name="image_view" pkg="image_view" type="image_view">
    <remap from="image" to="/zbar_ros/image"/>
  </node>

  <node name="image_detector" pkg="rotors_gazebo" type="image_detector" output="screen">
  <param name="target_image_path" value="$(find rotors_gazebo)/resource/1.png"/>
  </node>
</launch>